# ============================================================
# AWS CREDENTIALS - Copy this file to .env and fill in values
# ============================================================

# Your AWS Access Key ID (from IAM console)
AWS_ACCESS_KEY_ID=your_access_key_id_here

# Your AWS Secret Access Key (from IAM console)
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Region to scan (e.g., us-east-1, ap-south-1, eu-west-1)
AWS_DEFAULT_REGION=us-east-1

# Optional: AWS Session Token (only needed for temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# ============================================================
# ZOMBIE DETECTION THRESHOLDS (optional - defaults shown)
# ============================================================

# EC2: Mark as zombie if average CPU utilization < this % over 7 days
EC2_CPU_ZOMBIE_THRESHOLD=1.0

# Snapshots: Mark as zombie if older than this many days
SNAPSHOT_AGE_DAYS=30

# CloudWatch lookback period in days
CLOUDWATCH_DAYS=7
